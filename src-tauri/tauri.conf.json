{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Math Visualizer",
  "version": "0.1.0",
  "identifier": "de.cyphercom.mathvisualizer",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Math Visualizer",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; connect-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"]
  }
}
